{
  "schemaVersion": 1,
  "framework": "selenium",
  "testId": "testClasses.integration.marketing.promotionsAndCoupons.WebstorePromotionAndCouponVerificationTest#T01_verifyAmountOfBrandCouponFunctionality",
  "scenario": {
    "summary": "Admin creates two Amount Off Brand coupon promotions and one Percent Off Brand coupon promotion for the brand on store Multistore4 and reads back the generated coupon codes. A registered webstore user checks that the coupons are rejected for a non-brand product and below the minimum quantity, accepted for a brand product at quantity 5 and 6, places an Authorize.Net order, and admin verifies the unique coupon is marked used and the order summary matches.",
    "steps": [
      "Admin login; open Promotions and Coupons list",
      "Create Amount Off Brand coupon 1 (store StoreCode4 label, brand associated, min qty 2, min order 30, 1 coupon) and read the generated first coupon code",
      "Edit coupon 1: set display order, save, re-open and verify display order",
      "Create Amount Off Brand coupon 2 and read the generated second coupon code",
      "Create Percent Off Brand coupon (min qty 5, unique coupon) and read the generated third coupon code",
      "Open webstore and log in as the registered user",
      "Add the non-brand product to cart, apply first coupon, verify invalid promo message, remove coupon and empty cart",
      "Add the brand product (qty 1), apply third coupon, verify invalid promo message",
      "Set cart quantity to 5 (MinimumQuantity of percent coupon); verify percent coupon success message and order total",
      "Set quantity back to 1, apply first coupon, verify invalid promo message",
      "Set quantity to 6; verify first coupon success message; apply second coupon and verify its message",
      "Verify order summary calculations; checkout; verify coupon messages on checkout",
      "Select custom flat rate shipping, read order summary amounts, pay with Authorize.Net card, verify and read order receipt; log off",
      "Admin: verify the percent coupon is flagged as used; open the order and verify the order summary matches the webstore"
    ],
    "entitiesTouched": [
      "store",
      "brand",
      "product",
      "user",
      "promotion",
      "cart",
      "order"
    ],
    "stateChanges": [
      "Creates promotion 'runTime Amount Off Brand Coupon1' (code runTimeAmountOffBrandCoupon1, Amount Off Brand, 1 generated coupon) on Multistore4",
      "Creates promotion 'runTime Amount Off Brand Coupon2' (code runTimeAmountOffBrandCoupon2, Amount Off Brand, 1 generated coupon) on Multistore4",
      "Creates promotion 'runTime Percent Off Brand Coupon' (code runTimePercentOffBrandCoupon, Percent Off Brand, unique coupon) on Multistore4",
      "Updates display order of coupon 1",
      "Registered user's cart: products added, removed, quantities changed, coupons applied",
      "Places an order for the brand product (qty 6) with Authorize.Net payment; consumes the generated coupons (percent coupon marked used)",
      "No teardown of created promotions or the order is visible in the scanned steps"
    ],
    "assertions": [
      "Record updated success messages after promotion create/edit",
      "Display order of coupon 1 equals the value set",
      "Invalid promo code message for the non-brand product and for quantities below the coupon minimums",
      "Coupon success messages equal the configured promotional messages (percent coupon, coupon 1, coupon 2) in cart and on checkout",
      "Order total equals subtotal minus the percent discount",
      "Order summary calculations without voucher are consistent",
      "Order receipt is shown and order number captured",
      "Admin: unique percent coupon is flagged as used",
      "Admin order summary amounts equal the webstore summary amounts"
    ],
    "evidence": [
      "Method name T01_verifyAmountOfBrandCouponFunctionality and the step list in the scan (createBrandCouponCode x3, applyCoupon, setQuantity, Authorize.Net checkout, verifyIsUniqueCouponUsedStatus)",
      "Profile: z-2420004 is an active SimpleProduct of brand BlackAndDecker, inventory 25 (several rows matched, store MaxwellsHardware on first row)",
      "Profile: z-2300014 is an active SimpleProduct of brand AmericanStandard, inventory 10; the test uses it to show the brand coupon is rejected, so it must NOT be of the promotion brand",
      "Profile: brand 'Black + Decker' (code BlackAndDecker) is active; its source cell has no traced usage, it is taken as the brandsToAssociate value used by associateBrandsToDiscounts",
      "Profile: store 'Maxwell's Hardware Multistore4' (MaxwellsHardwareMultistore4) is found but isActive=false",
      "Profile: all runTime* promotion codes and names are NOT_FOUND, consistent with the test creating them",
      "Highest cart quantity of the brand product is the literal 6 (line 265); MinimumQuantity 5 is also set",
      "The InitialQuantity source for the non-brand product (WithoutAddonAndPersonalizeProduct) is not in the scan, so its quantityUsed is not set",
      "The admin brand search uses the 'Brand Name' / 'Is' filter options",
      "AIO preconditions not available: the Jira connector is not authorized and work/aio/ is empty",
      "testStoreURL target store is not resolved by the scan; store param assumed to be the promotion store MaxwellsHardwareMultistore4"
    ],
    "confidence": "medium",
    "needsReview": true
  },
