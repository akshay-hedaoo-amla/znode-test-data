{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/pdp/verify-quick-view-functionality-on-pdp.spec.ts > Webstore - PDP > verify quick view functionality on pdp",
  "scenario": {
    "summary": "Guest opens a product PDP by SKU, then opens Quick View for every product in its Frequently Bought and You May Also Like sections and checks each one's name, SKU, category, retail and sales price, three tiered offers, rating, quantity, Add to Cart and inventory.",
    "steps": [
      "Open the webstore as a guest (empty storageState).",
      "Search the product SKU, assert 'Showing 1 of 1 Results', open the result, assert the image and product heading.",
      "Scroll to the first related section, assert 'Frequently Bought', and Quick View each listed product.",
      "Scroll to the second related section, assert 'You May Also Like', and Quick View each listed product.",
      "In each Quick View assert name, SKU:<sku>, category, retail and sales price, the three tiers (Buy N or more, $price/item, Save N%), star, quantity input, Add to Cart and (when given) inventory text, then close."
    ],
    "entitiesTouched": [
      "product",
      "related_product",
      "category",
      "price",
      "tier_price",
      "inventory",
      "store"
    ],
    "stateChanges": [],
    "assertions": [
      "Search shows exactly one result; heading equals the product name.",
      "Related section headings 'Frequently Bought' and 'You May Also Like'.",
      "Each related product's Quick View shows its name, SKU, category, retail and sales prices, three tier offers and inventory as listed in the test data."
    ],
    "evidence": [
      "Title 'verify quick view functionality on pdp' and step labels '1) Search + open the product PDP', '2) Frequently Bought - Quick View each product', '3) You May Also Like - Quick View each product' match the flow.",
      "Profile: productSKU z-1234579 FOUND as BundleProduct, active, PRODUCTION, inventory 28362, storefront index 1. Related products z-1234606, z-1234605 (Frequently Bought) and z-1234602, z-1234603, z-1234604 (You May Also Like) FOUND as active SimpleProducts; z-1234603 shows inventory -619687597 (its data inventory is empty, so the test skips the inventory check for it).",
      "Missing key: the test needs a product whose Frequently Bought and You May Also Like lists hold products with retail/sales prices and three tier prices. No vocabulary key covers a product with related (linked) products or tier prices; that need is left out. PRODUCT_BUNDLE_IN_STOCK covers only the main product, with today's record as the preferred one. The related products' names and SKUs are recorded as data of alias product (they follow from the main product's links); their prices, tiers, categories and inventory are expected-output derived from them.",
      "youMayAlsoLike.1.inventory (empty string, json line 41) is not listed in sources: a source value must not be empty.",
      "strategy migrate: loadData is used, but prices, tier prices and discounts asserted in Quick View depend on the data (swap rule 3) and the related-product values map to no key output (swap rule 2).",
      "No linked AIO cases."
    ],
    "confidence": "low",
    "needsReview": true
  },
  "requires": [
    {
      "key": "PRODUCT_BUNDLE_IN_STOCK",
      "alias": "product",
      "params": {
        "store": "MaxwellsHardware",
        "quantityUsed": 1,
        "minAddOns": 0,
        "minPersonalizableAttributes": 0
      },
      "preferred": {
        "source": 0,
        "required": false
      }
    }
  ],
