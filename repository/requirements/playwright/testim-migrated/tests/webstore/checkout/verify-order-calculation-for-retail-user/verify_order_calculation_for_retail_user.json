{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/checkout/verify-order-calculation-for-retail-user.spec.ts > Webstore - Checkout > verify order calculation for retail user",
  "scenario": {
    "summary": "A registered retail user signs in, adds a simple product (quantity 5), proceeds to checkout, checks the section labels, the address form required-field messages and the empty-voucher message, then selects Custom Flat Rate shipping and checks the order total calculation (within 0.05). No order is placed.",
    "steps": [
      "Start with an empty storageState and sign in with the dedicated retail account.",
      "Add the simple product with quantity 5, open the cart and proceed to checkout (the account default address is used).",
      "Check the checkout section labels.",
      "Open an empty address form, save it and check the seven required-field messages; cancel.",
      "Apply an empty voucher and check 'Please enter valid voucher.'.",
      "Select Ship Complete + Custom Flat Rate shipping, wait for Handling Charges and a non-zero order total, read the totals and check the calculation."
    ],
    "entitiesTouched": [
      "user",
      "product",
      "shipping",
      "cart"
    ],
    "stateChanges": [
      "Registered user's cart filled with the simple product",
      "No address saved, no order placed"
    ],
    "assertions": [
      "Section labels equal the test data texts (fixed UI text).",
      "Display name, first/last name, phone, street, postal code and city required messages equal the test data.",
      "Empty voucher shows 'Please enter valid voucher.'.",
      "Handling charge label equals 'Handling Charges'.",
      "Order total > 0 and |subTotal + shipping + handling + tax - discount - shippingDiscount - orderTotal| <= 0.05 (all amounts read from the page)."
    ],
    "evidence": [
      "Title 'verify order calculation for retail user' matches the flow.",
      "Credentials (masked) name the existing registered user: USER_WEBSTORE_REGISTERED with preferred.required true (credential source).",
      "simpleProduct z-1002656 added at productQuantity 5: PRODUCT_SIMPLE_IN_STOCK, quantityUsed 5. z-1002656 appears in the spec only inside a comment.",
      "DOUBT: the spec relies on the account already having a default address (proceedFromCart goes to shipping); USER_WEBSTORE_REGISTERED does not constrain that.",
      "The calculation compares amounts read from the page; 0 and 0.05 are a threshold and a rounding tolerance (config).",
      "Masked error-message and heading values (scanner masked them by key name) are expected-output, kept masked.",
      "checkoutPage.selectShippingMethod clicks Ship Complete and then lblShippingMethodFLAT (Custom Flat Rate): SHIPPING_FLAT_RATE_ON_STORE with shippingCode FLAT. Destination country assumed 'us' (the address is masked or is the account's default address); assumption.",
      "Store MaxwellsHardware: the store every migrated webstore spec runs on (same as the approved shopping-cart and PDP entries); not named in the scan.",
      "Profile (atstage 2026-10-31) has no observations for this spec: every source is profiled false.",
      "swap: data only through loadData (simpleProduct -> product.sku; credentials kept), totals computed from page values only, messages/labels fixed UI text, no data value in the spec code, no other data file."
    ],
    "confidence": "medium",
    "needsReview": true
  },
  "requires": [
    {
      "key": "USER_WEBSTORE_REGISTERED",
      "alias": "user",
      "params": {
        "store": "MaxwellsHardware"
      },
      "preferred": {
        "source": 0,
        "required": true
      }
    },
    {
      "key": "PRODUCT_SIMPLE_IN_STOCK",
      "alias": "product",
      "params": {
        "quantityUsed": 5,
        "store": "MaxwellsHardware"
      },
      "preferred": {
        "source": 2,
        "required": false
      }
    },
    {
      "key": "SHIPPING_FLAT_RATE_ON_STORE",
      "alias": "shipping",
      "params": {
        "shippingCode": "FLAT",
        "countries": "us",
        "store": "MaxwellsHardware"
      }
    }
  ],
