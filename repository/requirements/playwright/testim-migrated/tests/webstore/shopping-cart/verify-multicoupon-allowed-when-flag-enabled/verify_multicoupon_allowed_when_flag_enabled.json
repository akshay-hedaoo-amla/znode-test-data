{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-multicoupon-allowed-when-flag-enabled.spec.ts > Webstore - Shopping Cart > verify multicoupon allowed when flag enabled",
  "scenario": {
    "summary": "A registered user applies a Percent Off Product coupon to two products raised to quantity 5, then stacks an Amount Off Order coupon; both coupons allow clubbing, so both apply and the discount is percent x subtotal + flat amount. No order.",
    "steps": [
      "Sign in as the registered user, empty the cart and remove all coupons",
      "Add sku1 and sku2 at qty 1, apply couponCode1, raise both lines (found by name1, name2) to updatedQuantity",
      "Coupon 1 at index 0: success message and code; one coupon applied",
      "SKU labels show sku1 and sku2",
      "Check discount = discountAmount% x subtotal and order total = subtotal - discount",
      "Apply couponCode2: two coupons applied, labels index 0 = couponCode1 and index 1 = couponCode2, success message at index 1",
      "Check combined discount = discountAmount% x subtotal + discountAmount2 and order total = subtotal - discount",
      "Remove all coupons, empty cart, log out"
    ],
    "entitiesTouched": [
      "product",
      "promotion",
      "user",
      "cart"
    ],
    "stateChanges": [
      "Both coupons are created per run through the API (consumable COUPON_* keys); the test only applies and removes them, no order is placed",
      "Registered user's cart: products added, coupons applied/removed, emptied at cleanup"
    ],
    "assertions": [
      "Coupon message at index 0 equals \"- \" + promoAppliedSuccesssMessage; coupon row 0 shows couponCode1; applied coupon count 1",
      "SKU labels equal \"SKU: \" + sku1 / sku2",
      "Discount close to subtotal x discountAmount/100; order total close to subtotal - discount",
      "Applied coupon count 2; coupon labels 0 and 1 equal couponCode1 and couponCode2; message at index 1 is the success message",
      "Combined discount close to subtotal x discountAmount/100 + discountAmount2; order total close to subtotal - discount",
      "Empty cart message visible; sign-in link visible after logout"
    ],
    "evidence": [
      "Title: 'verify multicoupon allowed when flag enabled'",
      "User decision: no store key; the 'flag' is each coupon's Is Allowed With Other Coupon - both created with allowedWithOtherCoupons true",
      "Profile: PRODUCT10 (Percent Off Product, 10.0, orderMinimum 400) and ORDER15 (Amount Off Order, 15.0, orderMinimum 1) on MaxwellsHardware; sku1 z-2100007 and sku2 z-2100005 are active in-stock simple products",
      "No profile check: both coupons apply to every profile (allProfiles true)",
      "Discount assertions use the resolved coupons' discountAmount (role data), not the literals 10.00 and 15.0",
      "coupon2 orderMinimum left out: the collection default (0) is met by any cart",
      "Links: coupon1 is created for both products (productId @product1.productId, secondProductId @product2.productId), so the discount is asserted over both lines as the original spec does (User decision)"
    ],
    "confidence": "medium",
    "needsReview": true
  },
