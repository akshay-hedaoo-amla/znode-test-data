  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-save-for-later-for-group-products.spec.ts > Webstore - Shopping Cart > verify save for later for group products",
  "scenario": {
    "summary": "A registered user signs in, clears cart and saved items, adds two grouped products (the second with one add-on), saves both for later, verifies name, price, quantity, group child and add-on of the saved items, moves both back, checks the saved list is empty, removes all and logs out.",
    "steps": [
      "Sign in as the registered user, empty the cart and clear saved items",
      "Add product1 (quantity 1) and product2 (quantity 1, one add-on selected) from their PDPs; open the cart (2 line items)",
      "Save each for later; check the toast each time",
      "Verify each saved item: name, price, quantity, group child name by child SKU, add-on description (product2)",
      "Check heading 'Saved Item(s) (2)'",
      "Move each saved item back to the cart (toast each)",
      "Check the Saved Items count is 0",
      "Remove all items from the cart; check the empty-cart message; log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart",
      "saved_item"
    ],
    "stateChanges": [
      "User's cart emptied and saved-for-later list cleared at start",
      "Two grouped products (one with add-on) added, saved for later, moved back, then cart emptied",
      "No order is placed"
    ],
    "assertions": [
      "Alert contains movedToSavedItemsMessage after each save",
      "Saved item name, price and quantity 1 for both products",
      "Group child name (by childSku) contains childName for both products",
      "product2 add-on description contains addOnDescription",
      "Saved Items heading contains 'Saved Item(s) (2)'",
      "Alert contains movedToCartMessage after each Move To Cart; saved item count reaches 0",
      "Empty cart message; sign-in link after logout"
    ],
    "evidence": [
      "Title: 'verify save for later for group products'; step labels 1) to 6) match the flow",
      "Profile: z-2200003 and z-2200006 FOUND as active GroupedProduct, PRODUCTION, inventory 250/500",
      "Profile: child SKUs z-2200004 and z-2200007 FOUND with an active child, inventory 1000",
      "Profile: add-on value 124 (products.1.addOns.0) profiled as product_addons with addOnCount 0 (looked up by the add-on id, not by the product)",
      "Add-on description 'Checkbox : ...' implies a checkbox add-on group; PRODUCT_GROUPED_IN_STOCK has no addOnDisplayType param",
      "Spec carries a MAINTENANCE NOTE: last AT Stage run failed waiting for the empty-cart message (not triaged); recorded as evidence only"
    ],
    "confidence": "medium",
    "needsReview": true
  },
