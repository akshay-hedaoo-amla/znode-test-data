  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-save-for-later-for-simple-products.spec.ts > Webstore - Shopping Cart > verify save for later for simple products",
  "scenario": {
    "summary": "A registered user signs in, clears cart and saved items, adds one simple product, saves it for later, checks the saved item and the Saved Items headers, moves it back, then saves and removes it again. Then adds three simple products, saves each for later, verifies all three, removes all saved items and logs out.",
    "steps": [
      "Sign in as the registered user, empty the cart and clear saved items",
      "Add product1 (quantity 1) and open the cart",
      "Save product1 for later; check the moved-to-saved-items toast",
      "Check saved item name, SKU, price, quantity and heading 'Saved Item(s) (1)'",
      "Check Saved Items headers: heading, Item price, Quantity, Move To Cart, Remove all items",
      "Move the saved item back to the cart; check the moved-back toast",
      "Save product1 for later again, remove all saved items; check the empty-cart message",
      "Empty cart and saved items; add product1, product2, product3 (quantity 1 each); open the cart (3 line items)",
      "Save each for later (toast each); verify name, SKU, price, quantity of each and heading 'Saved Item(s) (3)'",
      "Remove all saved items; check the empty-cart message",
      "Log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart",
      "saved_item"
    ],
    "stateChanges": [
      "User's cart emptied and saved-for-later list cleared at start",
      "Products added to cart, moved to saved items and back; saved items removed at the end",
      "No order is placed"
    ],
    "assertions": [
      "Alert contains movedToSavedItemsMessage after each save for later",
      "Alert contains movedToCartMessage after Move To Cart",
      "Saved item name and price contain the product's name and price; SKU visible; quantity input equals 1",
      "Saved Items heading contains 'Saved Item(s) (N)' for N = 1 and 3",
      "Saved Items headers: Item price, Quantity, Move To Cart, Remove all items",
      "Empty cart message after removing all saved items (twice)",
      "Sign-in link visible after logout"
    ],
    "evidence": [
      "Title: 'verify save for later for simple products'; step labels '0) Sign in' to '4) Log out' match the flow",
      "Profile: z-2420004, z-2460001, z-1234567 FOUND as active SimpleProduct, PRODUCTION, inventory 235/250/999931 (not filtered by store)",
      "Product name, price and SKU are asserted on the saved item, so they are outputs of each product need",
      "Store: the testim-migrated webstore suite runs against MaxwellsHardware (as in the approved shopping-cart example)"
    ],
    "confidence": "high"
  },
