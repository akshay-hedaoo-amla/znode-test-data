{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-cart-page-headers-for-retail-user-with-bundle-product.spec.ts > Webstore - Shopping Cart > verify shopping cart navigation / page headers for retail user with bundle product",
  "scenario": {
    "summary": "A registered retail user signs in, empties the cart, adds a bundle product and a second product, raises the bundle line to quantity 2, checks the line, sub total, order total and header total math, checks the bundle line (name, SKU, unit cost, included child products), removes all items and logs out.",
    "steps": [
      "Sign in as the registered user and empty the cart",
      "Add products[0] (bundle, quantity 1) and products[1] (quantity 1); open the cart and wait for 2 line items",
      "Find the bundle line item by products[0].name",
      "Set the bundle line quantity to updatedQuantity (2); row total equals lineCost * 2",
      "Check every line (unit > 0, row total = unit * qty), sub total, order total (sub total minus discount) and header total",
      "Check the bundle line: name, \"SKU: <sku>\", unit cost = lineCost, and each childDetails entry inside the bundle child container (childContainerSku)",
      "Remove all items, check the empty cart message, log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart"
    ],
    "stateChanges": [
      "Registered user's cart: emptied, 2 products added, bundle quantity set to 2, then all items removed",
      "No order is placed"
    ],
    "assertions": [
      "Cart has data.products.length (2) line items and the bundle line is found by name",
      "Bundle row total is close to parsePrice(lineCost) * updatedQuantity, precision 2",
      "Each line's unit cost is > 0 and its row total is close to unit * quantity, precision 2",
      "Sub total is > 0 and close to the sum of the line totals, precision 2",
      "Order total is > 0 and close to sub total minus discount, precision 2",
      "Header cart total is close to the order total, precision 2",
      "Bundle line name contains products[0].name; SKU text equals \"SKU: \" + products[0].sku; unit cost text equals products[0].lineCost ($500.00)",
      "Bundle child container contains each of the 3 childDetails strings (\"Qty: 1 | <child sku> - <child name>\")",
      "Remove All Items link is visible; after removing, the empty cart message is visible and equals emptyShoppingCartMessage",
      "Sign-in link is visible after logout"
    ],
    "evidence": [
      "Title: 'verify shopping cart navigation / page headers for retail user with bundle product'",
      "Step labels: '1) Sign in and add the bundle + the second product' ... '6) Log out'",
      "Profile: products[0].sku z-1234579 is an active BundleProduct, publishState PRODUCTION, inventory 28362 (not store-filtered)",
      "Profile: products[1].sku z-12345886 is an active BundleProduct but publishState DRAFT, inventory 100; PRODUCT_BUNDLE_IN_STOCK requires production, so the preferred record will likely be rejected and the resolver falls back",
      "childContainerSku equals the bundle SKU (z-1234579); childDetails name three child SKUs (z-1234582, z-1234607, z-1234580)",
      "Store: the Playwright webstore pilot runs on MaxwellsHardware (as in the approved coupon example); the spec names no store"
    ],
    "confidence": "medium",
    "needsReview": true
  },
  "requires": [
    {
