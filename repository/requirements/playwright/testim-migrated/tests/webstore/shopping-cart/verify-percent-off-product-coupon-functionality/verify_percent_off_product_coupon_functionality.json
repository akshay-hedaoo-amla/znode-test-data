{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-percent-off-product-coupon-functionality.spec.ts > Webstore - Shopping Cart > verify percent off product coupon functionality",
  "scenario": {
    "summary": "A registered user (the selected profile) checks a Percent Off Product coupon: rejected for a product it does not cover and below the minimum, applied when two eligible products are raised to quantity 5 (percent of subtotal). As a guest (non-selected profile) the coupon is rejected. No order.",
    "steps": [
      "Sign in as the registered user, empty the cart and remove any coupon",
      "Add the other product (sku1) at qty 1, apply couponCode: Invalid coupon code, no discount; remove coupon, empty cart",
      "Add the two eligible products (sku2, sku3) at qty 1, apply couponCode: Invalid coupon code, no discount",
      "Raise both lines (found by name2, name3) to updatedQuantity: success message, coupon row, discount label",
      "Check unit costs > 0, discount = discountAmount% x subtotal, order total = subtotal - discount",
      "Empty the cart, log out; as guest add both eligible products at updatedQuantity and apply couponCode: not applied, Invalid coupon code",
      "Remove coupon, empty cart"
    ],
    "entitiesTouched": [
      "product",
      "promotion",
      "user",
      "cart"
    ],
    "stateChanges": [
      "Coupon is created per run through the API (consumable COUPON_* key); the test only applies and removes it, no order is placed, so one redemption is enough",
      "Registered user's cart and guest cart: products added, coupon applied/removed, emptied at cleanup"
    ],
    "assertions": [
      "Other product: invalid message \"- \" + invalidCouponMessage, coupon row shows couponCode, no discount",
      "Below minimum: invalid message, coupon row shows couponCode, no discount",
      "Both lines at updatedQuantity; success message \"- \" + promoAppliedSuccesssMessage; coupon row shows couponCode; discount label visible",
      "Unit costs > 0; discount close to subtotal x discountAmount/100; order total close to subtotal - discount",
      "Guest: no success message, invalid message and coupon row shown",
      "Empty cart message visible after cleanup"
    ],
    "evidence": [
      "Title: 'verify percent off product coupon functionality'",
      "Spec note: PRODUCT10 is 10% off two eligible products, profile-restricted to the signed-in user; the non-selected-profile check runs as guest",
      "Profile: PRODUCT10 is a Percent Off Product coupon on MaxwellsHardware, discount 10.0, orderMinimum 400; today the minimum is an order amount, the key models it as minimumQuantity <= quantityUsed (5)",
      "Profile: sku1 z-4567890, sku2 z-2100007, sku3 z-2100005 are active in-stock simple products",
      "Discount assertions use the resolved coupon's discountAmount (role data), not the literal 10.00",
      "allProfiles false, profile Retail Customer (the signed-in user's profile); the guest (Anonymous) must not get it",
      "Links: the coupon is created for both products (productId @product1.productId, secondProductId @product2.productId), so the discount is asserted over both lines as the original spec does (User decision)"
    ],
    "confidence": "medium",
    "needsReview": true
  },
