  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-save-cart-for-group-product.spec.ts > Webstore - Shopping Cart > verify save cart for group product with add-ons and personalization",
  "scenario": {
    "summary": "A registered user signs in, adds a grouped product with DisplayText personalization and a checkbox add-on, saves the cart under a new name, adds a second grouped product with an add-on and saves it into the existing saved cart, moves the saved cart back and checks both group lines. Cleans up.",
    "steps": [
      "Sign in with the test account; empty the cart; delete leftover saved carts whose name starts with cartNameBase",
      "Add product1 (grouped, quantity 1) with personalizationText and add-on addOnCheckboxId; cart shows 1 line item",
      "Save the cart as cartNameBase + timestamp; check success message and heading; find the saved cart id by name",
      "Add product2 (grouped, quantity 1) with add-on addOnCheckboxId; save into the existing saved cart; check success message and heading",
      "Move the saved cart back; cart shows 2 line items",
      "Check product2: name, child name, unit price, quantity, row total",
      "Check product1: name, child name, \"DisplayText : \" personalization, add-on, unit price, quantity, row total",
      "Delete the saved cart, empty the cart, log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart",
      "saved_cart"
    ],
    "stateChanges": [
      "Registered user's cart: emptied, grouped products added, emptied at cleanup",
      "Saved cart created by the test (cartNameBase + timestamp), updated with product2, deleted at cleanup; leftover saved carts with the same prefix deleted at start",
      "No order is placed"
    ],
    "assertions": [
      "Alert contains cartSavedSuccesssMessage after saving a new cart and after saving into the existing cart; Saved Cart heading visible",
      "Saved cart is listed by name (row id truthy)",
      "product2 line: name, group child (childSku) contains childName, unit cost equals price, quantity, row total close to price x quantity",
      "product1 line: name, child name, \"DisplayText : \" + personalizationText, \"Checkbox : \" + addOnDescription, unit cost, quantity, row total",
      "Sign-in link visible after logout"
    ],
    "evidence": [
      "Title: 'verify save cart for group product with add-ons and personalization'; step labels 1) to 7) match the flow",
      "Spec line 72: addProductWithPersonalization(product1.sku, quantity, personalizationText, [addOnCheckboxId]); line 98: addProductWithAddOns(product2.sku, quantity, [addOnCheckboxId])",
      "Profile: z-2200003 active GroupedProduct, PRODUCTION, inventory 250, child z-2200004 found (childInventory 100), add-on 512 found (addOnCount 5, addOnInventory 200)",
      "Profile: z-2200006 active GroupedProduct, PRODUCTION, inventory 500, child z-2200007 found (childInventory 100), add-on 124 found (addOnCount 3, addOnInventory 3000)",
      "product1.id and product2.id (408, 411) are in the test data but the spec does not use them",
      "Store MaxwellsHardware as in the approved shopping-cart and PDP requirements; no linked cases, no AIO files"
    ],
    "confidence": "medium",
    "needsReview": true
  },
