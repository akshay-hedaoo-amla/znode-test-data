  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-cart-page-headers-for-retail-user-with-simple-product.spec.ts > Webstore - Shopping Cart > verify shopping cart navigation / page headers for retail user with simple product",
  "scenario": {
    "summary": "A registered user signs in, empties the cart, adds three simple products, checks the cart page headers and labels, updates the first line item's quantity, checks line totals, subtotal, order total and header total, removes all items and logs out.",
    "steps": [
      "Sign in as the registered user and empty the account cart",
      "Add product1, product2 and product3 with quantity 1 each",
      "Open the cart and check breadcrumb, headings, column labels, Remove all link, order summary labels, navigation and Shop by Brands link",
      "Check the cart has 3 line items",
      "Set the first line item's quantity to updatedQuantity (2) and check its row total = price x 2",
      "Check each row total = unit x quantity, subtotal = sum, order total = subtotal - discount, header total = order total",
      "Remove all items and check the empty-cart message",
      "Log out and check the sign-in link"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart"
    ],
    "stateChanges": [
      "Registered user's cart: emptied, three products added, first quantity changed to 2, then all items removed",
      "No order is placed"
    ],
    "assertions": [
      "Breadcrumb, cart heading, Items, Item price, Quantity, Total price, Remove all items, Order Summary, Sub Total, Discount (On Sub Total, only when a discount applies) and Order Total match the test data",
      "Navigation span and Shop by Brands link visible",
      "3 line items",
      "First row total close to price x updatedQuantity",
      "Unit prices > 0; row totals, subtotal, order total and header total consistent",
      "Empty cart message equals emptyShoppingCartMessage",
      "Sign-in link visible after logout"
    ],
    "evidence": [
      "Title: 'verify shopping cart navigation / page headers for retail user with simple product'",
      "Signs in with the username and password from the test data (masked)",
      "Profile: z-2420004, z-2460001, z-1234567 are active SimpleProducts in PRODUCTION (inventory 235, 250, 999931, store not filtered)",
      "products[0] quantity is updated to updatedQuantity 2, so product1 quantityUsed is 2",
      "Product names and ids are in the data but not asserted (spec comment: per-item checks were not migrated)"
    ],
    "confidence": "high",
    "needsReview": false
  },
