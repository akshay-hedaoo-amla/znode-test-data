  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-cart-page-headers-for-guest-user.spec.ts > Webstore - Shopping Cart > verify shopping cart navigation / page headers for guest user",
  "scenario": {
    "summary": "A guest adds three simple products to the cart, checks the cart page headers and labels, updates the first line item's quantity, checks line totals, subtotal, order total and header total, checks each line item's name, SKU, unit price and quantity, then removes all items.",
    "steps": [
      "Guest: add product1, product2 and product3 with quantity 1 each",
      "Open the cart and check breadcrumb, headings, column labels, Remove all link, order summary labels, navigation and Shop by Brands link",
      "Check the cart has 3 line items",
      "Set the first line item's quantity to updatedQuantity (2) and check its row total = price x 2",
      "Check each row total = unit x quantity, subtotal = sum, order total = subtotal - discount, header total = order total",
      "Check each line item's name, 'SKU: ' + sku, unit price and quantity",
      "Remove all items and check the empty-cart message"
    ],
    "entitiesTouched": [
      "product",
      "cart"
    ],
    "stateChanges": [
      "Guest cart: three products added, first quantity changed to 2, then all items removed",
      "No order is placed"
    ],
    "assertions": [
      "Breadcrumb, cart heading, Items, Item price, Quantity, Total price, Remove all items, Order Summary, Sub Total, Discount (On Sub Total, only when a discount applies) and Order Total match the test data",
      "Navigation span and Shop by Brands link visible",
      "3 line items",
      "First row total close to price x updatedQuantity",
      "Unit prices > 0; row totals, subtotal, order total and header total consistent",
      "Each line item shows the product's name, SKU, price and quantity",
      "Empty cart message equals emptyShoppingCartMessage"
    ],
    "evidence": [
      "Title: 'verify shopping cart navigation / page headers for guest user'",
      "Runs as guest (empty storage state), no sign-in",
      "Profile: z-2420004, z-2460001, z-1234567 are active SimpleProducts in PRODUCTION (inventory 235, 250, 999931, store not filtered)",
      "products[0] quantity is updated to updatedQuantity 2, so product1 quantityUsed is 2",
      "The test asserts unit price text equals the data price, so the resolved product's name and price are supplied with its SKU"
    ],
    "confidence": "high",
    "needsReview": false
  },
  "requires": [
    {
      "key": "PRODUCT_SIMPLE_IN_STOCK",
      "alias": "product1",
      "params": {
