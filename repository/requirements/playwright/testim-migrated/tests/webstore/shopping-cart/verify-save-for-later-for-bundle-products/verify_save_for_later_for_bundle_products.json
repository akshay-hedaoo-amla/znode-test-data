{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-save-for-later-for-bundle-products.spec.ts > Webstore - Shopping Cart > verify save for later for bundle products",
  "scenario": {
    "summary": "A registered user signs in, clears cart and saved items, adds two bundle products (the first with one add-on), saves both for later, verifies name, SKU, price, quantity, included children and add-on of the saved items, moves both back, checks the saved list is empty, removes all and logs out.",
    "steps": [
      "Sign in as the registered user, empty the cart and clear saved items",
      "Add product1 (quantity 1, one add-on selected) and product2 (quantity 1) from their PDPs; open the cart (2 line items)",
      "Save each for later; check the toast each time and heading 'Saved Item(s) (2)'",
      "Verify product1 saved item: name, SKU, price, quantity, bundle children (Qty | SKU - name) and add-on description",
      "Verify product2 saved item: name, SKU, price, quantity and bundle description (included product)",
      "Move each saved item back to the cart (toast each)",
      "Check the Saved Items count is 0",
      "Remove all items from the cart; check the empty-cart message; log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart",
      "saved_item"
    ],
    "stateChanges": [
      "User's cart emptied and saved-for-later list cleared at start",
      "Two bundle products (one with add-on) added, saved for later, moved back, then cart emptied",
      "No order is placed"
    ],
    "assertions": [
      "Alert contains movedToSavedItemsMessage after each save",
      "Saved Items heading contains 'Saved Item(s) (2)'",
      "Saved item name, price, SKU and quantity 1 for both products",
      "product1 bundle child container contains each childDetails line; add-on description contains addOnDescription",
      "product2 bundle description contains bundleDescription",
      "Alert contains movedToCartMessage after each Move To Cart; saved item count reaches 0",
      "Empty cart message; sign-in link after logout"
    ],
    "evidence": [
      "Title: 'verify save for later for bundle products'; step labels 1) to 7) match the flow",
      "Profile: z-1234579 FOUND as active BundleProduct, PRODUCTION, inventory 28362",
      "Profile: z-12345886 FOUND as active BundleProduct but publishState DRAFT, inventory 100: the recorded product2 does not meet PRODUCT_BUNDLE_IN_STOCK (publishState production), so the resolver will fall back to another bundle",
      "Profile: add-on value 120 (products.0.addOns.0) and addOnDescription profiled as product_addons with addOnCount 0 (looked up by the add-on id, not by the bundle)",
      "Add-on description 'Checkbox : ...' implies a checkbox add-on group; PRODUCT_BUNDLE_IN_STOCK has no addOnDisplayType param",
      "products.0.bundleChildSku equals the bundle's own SKU (the child container is addressed by the parent SKU)"
    ],
    "confidence": "medium",
    "needsReview": true
  },
  "requires": [
    {
      "key": "PRODUCT_BUNDLE_IN_STOCK",
      "alias": "product1",
      "params": {
        "quantityUsed": 1,
        "minAddOns": 1,
        "minPersonalizableAttributes": 0,
        "store": "MaxwellsHardware",
        "addOnDisplayType": "CheckBox"
      },
      "preferred": {
        "source": 2,
        "required": false
      }
    },
    {
      "key": "PRODUCT_BUNDLE_IN_STOCK",
      "alias": "product2",
      "params": {
        "quantityUsed": 1,
        "minAddOns": 0,
        "minPersonalizableAttributes": 0,
        "store": "MaxwellsHardware"
      },
      "preferred": {
        "source": 12,
        "required": false
      }
    },
    {
