{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-save-cart-for-bundle-product.spec.ts > Webstore - Shopping Cart > verify save cart for bundle product with add-ons and personalization",
  "scenario": {
    "summary": "A registered user signs in, adds a bundle product with personalization text and a checkbox add-on, saves the cart under a new name, adds a second bundle product and saves it into the existing saved cart, then checks both bundles on the saved-cart edit page. Moves the saved cart to the cart and cleans up.",
    "steps": [
      "Sign in with the test account; empty the cart; delete leftover saved carts whose name starts with cartNameBase",
      "Add product1 (bundle, quantity 1) with personalizationText in the AdditionalInformation field and add-on addOnCheckboxId; cart shows 1 line item",
      "Save the cart as cartNameBase + timestamp; check success message and heading; find the saved cart id by name",
      "Add product2 (bundle, quantity 1); save into the existing saved cart; check success message and heading",
      "Open the saved cart edit page; check product1 name, bundle child lines, SKU, unit price, quantity, total, personalization and add-on",
      "Check product2 name, bundle child line, SKU, unit price, quantity and total",
      "Move the saved cart to the cart; delete the saved cart; empty the cart; log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart",
      "saved_cart"
    ],
    "stateChanges": [
      "Registered user's cart: emptied, bundles added, emptied at cleanup",
      "Saved cart created by the test (cartNameBase + timestamp), updated with product2, deleted at cleanup; leftover saved carts with the same prefix deleted at start",
      "No order is placed"
    ],
    "assertions": [
      "Alert contains cartSavedSuccesssMessage after saving a new cart and after saving into the existing cart; Saved Cart heading visible",
      "Saved cart is listed by name (row id truthy)",
      "Edit page, product1 (line id product1.id): name, each childDetails line, \"SKU: \" + sku, unit price, quantity, total close to price x quantity, \"AdditionalInformation : \" + personalizationText, \"Checkbox : \" + addOnDescription",
      "Edit page, product2 (line id product2.id): name, bundle child line description, \"SKU: \" + sku, unit price, quantity, total",
      "Sign-in link visible after logout"
    ],
    "evidence": [
      "Title: 'verify save cart for bundle product with add-ons and personalization'; step labels 1) to 6) match the flow",
      "Spec line 69: addProductWithAdditionalInfo(product1.sku, quantity, personalizationText, [addOnCheckboxId]); line 93: addProductOfAnyType(product2.sku)",
      "product1.id and product2.id (142, 903) locate the lines on the saved-cart edit page; bundleChildSku equals the bundle SKU and builds the divBundleProductChild<sku> test-id",
      "Profile: z-1234579 active BundleProduct, PRODUCTION, inventory 28362, add-on 120 found (addOnCount 4, addOnInventory 3000)",
      "Profile: z-12345886 active BundleProduct but publishState DRAFT, inventory 100: the preferred record fails publishState production, so the resolver will fall back for product2",
      "Profile: prices, ids and child details are not profiled (NO_RULE)",
      "Store MaxwellsHardware as in the approved shopping-cart and PDP requirements; no linked cases, no AIO files"
    ],
    "confidence": "medium",
    "needsReview": true
  },
