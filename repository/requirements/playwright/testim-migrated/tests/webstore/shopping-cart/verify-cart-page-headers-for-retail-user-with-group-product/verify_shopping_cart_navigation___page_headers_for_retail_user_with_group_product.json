{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-cart-page-headers-for-retail-user-with-group-product.spec.ts > Webstore - Shopping Cart > verify shopping cart navigation / page headers for retail user with group product",
  "scenario": {
    "summary": "A registered retail user signs in, empties the cart, adds two grouped products (the second with an add-on checkbox), raises the first grouped line to quantity 2, checks the line, sub total, order total and header total math, checks the grouped line (name, unit cost, quantity, child product name), removes all items and logs out.",
    "steps": [
      "Sign in as the registered user and empty the cart",
      "Add products[0] (grouped, quantity 1, no add-ons) and products[1] (grouped, quantity 1, add-on 120); open the cart and wait for 2 line items",
      "Find the grouped line item by products[0].name",
      "Set that line quantity to updatedQuantity (2); row total equals lineCost * 2",
      "Check every line (unit > 0, row total = unit * qty), sub total, order total (sub total minus discount) and header total",
      "Check the grouped line: name, unit cost = lineCost, quantity input = updatedQuantity, child name of childName.sku = childName.text",
      "Remove all items, check the empty cart message, log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart"
    ],
    "stateChanges": [
      "Registered user's cart: emptied, 2 grouped products added (one with an add-on), first line quantity set to 2, then all items removed",
      "No order is placed"
    ],
    "assertions": [
      "Cart has data.products.length (2) line items and the grouped line is found by name",
      "Grouped row total is close to parsePrice(lineCost) * updatedQuantity, precision 2",
      "Each line's unit cost is > 0 and its row total is close to unit * quantity, precision 2",
      "Sub total is > 0 and close to the sum of the line totals, precision 2",
      "Order total is > 0 and close to sub total minus discount, precision 2",
      "Header cart total is close to the order total, precision 2",
      "Grouped line name contains products[0].name; unit cost text equals products[0].lineCost ($22.48); quantity input has value updatedQuantity",
      "Grouped child name for childName.sku (z-2200004) equals childName.text",
      "Remove All Items link is visible; after removing, the empty cart message is visible and equals emptyShoppingCartMessage",
      "Sign-in link is visible after logout"
    ],
    "evidence": [
      "Title: 'verify shopping cart navigation / page headers for retail user with group product'",
      "Step label: '1) Sign in and add the two group products (2nd needs an add-on selection)'",
      "Profile: products[0].sku z-2200003 is an active GroupedProduct, PRODUCTION, inventory 250; its child z-2200004 has variantInventory 1000",
      "Profile: products[1].sku z-2200006 is an active GroupedProduct, PRODUCTION, inventory 500",
      "Profile: products[1].addOns[0] \"120\" lookup gives addOnCount 0 (the lookup may be by a different id than the PDP checkbox id); product2 asks minAddOns 1 because the spec selects one add-on",
      "Store: MaxwellsHardware (Playwright webstore pilot store; the spec names none)"
    ],
    "confidence": "medium",
    "needsReview": true
  },
