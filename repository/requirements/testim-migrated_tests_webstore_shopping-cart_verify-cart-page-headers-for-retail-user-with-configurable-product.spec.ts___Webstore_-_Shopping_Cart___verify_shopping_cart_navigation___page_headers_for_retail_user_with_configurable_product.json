{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-cart-page-headers-for-retail-user-with-configurable-product.spec.ts > Webstore - Shopping Cart > verify shopping cart navigation / page headers for retail user with configurable product",
  "scenario": {
    "summary": "A registered retail user signs in, empties the cart, adds one variant of a configurable product (Bulb Size / Color / Technology) with a radio add-on, raises the line to quantity 2, checks the line, sub total, order total and header total math, checks the line name, the selected attributes and the add-on, removes all items and logs out.",
    "steps": [
      "Sign in as the registered user and empty the cart",
      "On the PDP of productSKU select variant1BulbSize, variant1Color, variant1Technology and the add-on radio addOnRadioId; add to cart",
      "Open the cart and wait for 1 line item",
      "Set the line quantity to updatedQuantity (2); row total equals price1 * 2",
      "Check every line (unit > 0, row total = unit * qty), sub total, order total (sub total minus discount) and header total",
      "Check the line: name contains name1; attributes of variantSku show Bulb Size, Color and Technology; child description shows \"Radio : <addon1>\"",
      "Remove all items, check the empty cart message, log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart"
    ],
    "stateChanges": [
      "Registered user's cart: emptied, 1 configurable variant with add-on added, quantity set to 2, then all items removed",
      "No order is placed"
    ],
    "assertions": [
      "Cart has more than 0 line items",
      "Row total is close to parsePrice(price1) * updatedQuantity, precision 2",
      "Each line's unit cost is > 0 and its row total is close to unit * quantity, precision 2",
      "Sub total is > 0 and close to the sum of the line totals, precision 2",
      "Order total is > 0 and close to sub total minus discount, precision 2",
      "Header cart total is close to the order total, precision 2",
      "Line name contains name1",
      "Attributes of variantSku contain \"Bulb Size : <variant1BulbSize>\", \"Color : <variant1Color>\", \"Technology : <variant1Technology>\"",
      "Child product description contains \"Radio : <addon1>\"",
      "Remove All Items link is visible; after removing, the empty cart message is visible and equals emptyShoppingCartMessage",
      "Sign-in link is visible after logout"
    ],
    "evidence": [
      "Title: 'verify shopping cart navigation / page headers for retail user with configurable product'",
      "Step label: '1) Sign in and add the configurable variant (Small / White / LED + add-on)'",
      "Profile: productSKU B-100003 is an active ConfigurableProduct, PRODUCTION (name \"Havells Base B23 17-Watt Bulb\"); parent stock row NOT_FOUND (parent configurables carry no own stock)",
      "Profile: variantSku z-2510001 has 1 active variant, variantInventory 1000",
      "Profile: addon1 lookup gives addOnCount 2, addOnInventory 50",
      "name1 (\"75-Watt Equivalent BR40 ...\") differs from the parent name in the profile; it is likely the variant name shown in the cart",
      "The spec hardcodes the attribute labels \"Bulb Size\", \"Color\", \"Technology\" and the add-on display type \"Radio\"; PRODUCT_CONFIGURABLE_WITH_VARIANTS does not constrain attribute codes or the add-on display type, so a substituted product may not match these labels",
      "Store: MaxwellsHardware (Playwright webstore pilot store; the spec names none)"
    ],
    "confidence": "medium",
    "needsReview": true
  },
  "requires": [
    {
      "key": "PRODUCT_CONFIGURABLE_WITH_VARIANTS",
      "alias": "product",
      "params": {
        "quantityUsed": 2,
        "minVariants": 1,
        "minAddOns": 1,
        "minPersonalizableAttributes": 0,
        "store": "MaxwellsHardware",
        "addOnDisplayType": "RadioButton",
        "variantAttributes": "BulbSize,Color,Technology"
      },
      "preferred": {
        "source": 2,
        "required": false
      }
    },
    {
      "key": "USER_WEBSTORE_REGISTERED",
      "alias": "user",
      "params": {
        "store": "MaxwellsHardware"
      },
      "preferred": {
        "source": 0,
        "required": true
      }
    }
  ],
