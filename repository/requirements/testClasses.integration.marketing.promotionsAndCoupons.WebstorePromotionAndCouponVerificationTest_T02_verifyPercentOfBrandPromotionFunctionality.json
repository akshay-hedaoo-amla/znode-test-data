{
  "schemaVersion": 1,
  "framework": "selenium",
  "testId": "testClasses.integration.marketing.promotionsAndCoupons.WebstorePromotionAndCouponVerificationTest#T02_verifyPercentOfBrandPromotionFunctionality",
  "scenario": {
    "summary": "Admin checks the fields shown for the Percent Off Brand discount type, then creates a Percent Off Brand promotion (no coupon) for the brand on store Multistore4. A registered webstore user sees no discount for a non-brand product, a percent discount for the brand product, and then no discount after re-login with quantity 3.",
    "steps": [
      "Admin login; open Promotions and Coupons list",
      "Add new: select Percent Off Brand and verify discount amount, minimum quantity, minimum order amount and Find Brands fields; go back",
      "Create Percent Off Brand promotion (store StoreCode4 label, all profiles, 5 percent, min qty 1, min order 10, brand associated)",
      "Open webstore and log in as the registered user",
      "Add the non-brand product to cart; verify no discount; empty cart",
      "Add the brand product (qty 1); verify discount present and order total equals subtotal minus 5 percent",
      "Re-open webstore, log in again, add the brand product again, open cart",
      "Set quantity to 3 (MinimumQuantity1) and verify no discount is shown"
    ],
    "entitiesTouched": [
      "store",
      "brand",
      "product",
      "user",
      "promotion",
      "cart"
    ],
    "stateChanges": [
      "Creates promotion 'runTime Percent Off Brand Promotion ' (code runTimePercentOffBrandPromotion, Percent Off Brand, 5) on Multistore4",
      "Registered user's cart: products added and removed, quantity changed; the cart is left with the brand product",
      "No order is placed; no teardown of the created promotion is visible in the scanned steps"
    ],
    "assertions": [
      "Percent Off Brand discount type shows discount amount, minimum quantity, minimum order amount and Find Brands",
      "Record updated success message after creating the promotion",
      "No discount for the non-brand product",
      "Discount present for the brand product and order total equals subtotal minus the 5 percent discount",
      "No discount after setting quantity 3 in the second session"
    ],
    "evidence": [
      "Method name T02_verifyPercentOfBrandPromotionFunctionality and the scanned step list (verifyFieldsDisplayedOnSelectingPercentOffBrandDiscountType, createBrandPromotion, verifyDiscountAmountNotPresent/Present)",
      "Profile: z-2420004 active SimpleProduct of brand BlackAndDecker, inventory 25; z-2300014 active SimpleProduct of brand AmericanStandard, inventory 10",
      "The promotion has minimum quantity 1, so the 'no discount' check on z-2300014 relies on it NOT being of the promotion brand",
      "The final 'no discount at quantity 3' check is not explained by the scanned steps (source lines 386-393 are not in the step list); the reason needs human confirmation",
      "Highest cart quantity of the brand product is 3 (MinimumQuantity1)",
      "The InitialQuantity source for the non-brand product is not in the scan, so its quantityUsed is not set",
      "Profile: store MaxwellsHardwareMultistore4 found but isActive=false; runTime promotion code and name NOT_FOUND, consistent with the test creating them",
      "AIO preconditions not available: the Jira connector is not authorized and work/aio/ is empty"
    ],
    "confidence": "medium",
    "needsReview": true
  },
