{
  "schemaVersion": 1,
  "framework": "playwright",
  "testId": "testim-migrated/tests/webstore/shopping-cart/verify-save-for-later-for-configurable-products.spec.ts > Webstore - Shopping Cart > verify save for later for configurable products",
  "scenario": {
    "summary": "A registered user signs in, clears cart and saved items, adds three variants of one configurable product (picked by Bulb Size, Color and Technology swatches) as separate lines, saves each for later, verifies name, attributes, positive price and quantity, moves all back, checks the saved list is empty, removes all and logs out.",
    "steps": [
      "Sign in as the registered user, empty the cart and clear saved items",
      "Open the configurable product (productSKU) and add three variants in sequence, selected by Bulb Size / Color / Technology swatches (retry up to 3 times)",
      "Open the cart; expect 3 distinct line items found by variant name",
      "Save each for later (toast each); check heading 'Saved Item(s) (3)'",
      "Verify each saved variant: name, an attribute block with its three labels, unit price > 0 (warn on drift from the recorded price), quantity 1",
      "Move each saved item back to the cart (toast each)",
      "Check the Saved Items count is 0",
      "Remove all items from the cart; check the empty-cart message; log out"
    ],
    "entitiesTouched": [
      "product",
      "user",
      "cart",
      "saved_item"
    ],
    "stateChanges": [
      "User's cart emptied and saved-for-later list cleared at start",
      "Three variants added, saved for later, moved back, then cart emptied",
      "No order is placed"
    ],
    "assertions": [
      "Line count equals 3 and each variant's line item exists",
      "Alert contains movedToSavedItemsMessage after each save; heading contains 'Saved Item(s) (3)'",
      "Saved item name contains the variant name; an attribute block contains its Bulb Size, Color and Technology labels",
      "Saved unit price > 0 (the recorded price is only logged on drift)",
      "Saved quantity equals 1",
      "Alert contains movedToCartMessage after each Move To Cart; saved item count reaches 0",
      "Empty cart message; sign-in link after logout"
    ],
    "evidence": [
      "Title: 'verify save for later for configurable products'; step labels 1) to 6) match the flow",
      "Profile: B-100000 FOUND as active ConfigurableProduct, PRODUCTION (name 'Philips Base B22 9-Watt Bulb'); product_stock NOT_FOUND",
      "Profile: variant z-2510001 active, inventory 1000; variants z-2510012 and z-2510014 active but inventory null",
      "Spec comment says the master is z-2420004, which the profile shows is a SimpleProduct; the test itself searches data.productSKU (B-100000)",
      "The data shape fixes three attribute dimensions (Bulb Size, Color, Technology); PRODUCT_CONFIGURABLE_WITH_VARIANTS does not constrain the attribute set, so a substituted product must expose the same three attributes",
      "Recorded prices are not asserted (only > 0); the spec comment notes catalog price drift on AT"
    ],
    "confidence": "medium",
    "needsReview": true
  },
  "requires": [
    {
      "key": "PRODUCT_CONFIGURABLE_WITH_VARIANTS",
      "alias": "product",
      "params": {
        "quantityUsed": 1,
        "minVariants": 3,
        "minAddOns": 0,
        "minPersonalizableAttributes": 0,
        "store": "MaxwellsHardware"
      },
