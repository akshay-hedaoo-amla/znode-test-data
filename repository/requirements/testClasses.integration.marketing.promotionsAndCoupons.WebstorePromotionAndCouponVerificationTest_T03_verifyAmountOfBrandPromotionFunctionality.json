{
  "schemaVersion": 1,
  "framework": "selenium",
  "testId": "testClasses.integration.marketing.promotionsAndCoupons.WebstorePromotionAndCouponVerificationTest#T03_verifyAmountOfBrandPromotionFunctionality",
  "scenario": {
    "summary": "Admin creates an Amount Off Brand promotion (no coupon, $2 per item, min qty 2) for the brand on store Multistore4. A registered webstore user sees no discount for a non-brand product or for the brand product at quantity 1, a $4 discount at quantity 2, and then no discount after re-login with quantity 2.",
    "steps": [
      "Admin login; open Promotions and Coupons list",
      "Create Amount Off Brand promotion (store StoreCode4 label, all profiles, amount 2, min qty 2, min order 10, brand associated)",
      "Open webstore and log in as the registered user",
      "Add the non-brand product to cart; verify no discount; empty cart",
      "Add the brand product (qty 1); verify no discount",
      "Set quantity to 2 (MinimumQuantity); verify discount present, discount amount and order total equal subtotal minus 4",
      "Re-open webstore, log in again, add the brand product, open cart, set quantity 2, verify no discount"
    ],
    "entitiesTouched": [
      "store",
      "brand",
      "product",
      "user",
      "promotion",
      "cart"
    ],
    "stateChanges": [
      "Creates promotion 'runTime Amount Off Brand Promotion' (code runTimeAmountOffBrandPromotion, Amount Off Brand, 2) on Multistore4",
      "Registered user's cart: products added and removed, quantity changed; the cart is left with the brand product",
      "No order is placed; no teardown of the created promotion is visible in the scanned steps"
    ],
    "assertions": [
      "Record updated success message after creating the promotion",
      "No discount for the non-brand product and for the brand product below minimum quantity",
      "Discount present at quantity 2; discount amount as expected; order total equals subtotal minus DiscountAmount2 (4)",
      "No discount after setting quantity 2 in the second session"
    ],
    "evidence": [
      "Method name T03_verifyAmountOfBrandPromotionFunctionality and the scanned step list (createBrandPromotion, setQuantity, verifyDiscountAmount, verifyOrderTotalForDiscountAmount)",
      "Profile: z-2420004 active SimpleProduct of brand BlackAndDecker, inventory 25; z-2300014 active SimpleProduct of brand AmericanStandard, inventory 10",
      "The non-brand check on z-2300014 may also be explained by min qty 2; the scenario treats it as a non-brand control, like T01 and T02",
      "The final 'no discount at quantity 2' check is not explained by the scanned steps (source lines 471-480 are not in the step list); the reason needs human confirmation",
      "Highest cart quantity of the brand product is 2 (MinimumQuantity)",
      "The InitialQuantity source for the non-brand product is not in the scan, so its quantityUsed is not set",
      "Profile: store MaxwellsHardwareMultistore4 found but isActive=false; runTime promotion code and name NOT_FOUND, consistent with the test creating them",
      "AIO preconditions not available: the Jira connector is not authorized and work/aio/ is empty"
    ],
    "confidence": "medium",
    "needsReview": true
  },
