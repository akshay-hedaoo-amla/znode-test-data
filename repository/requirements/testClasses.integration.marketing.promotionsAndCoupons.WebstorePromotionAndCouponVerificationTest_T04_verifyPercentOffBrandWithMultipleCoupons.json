  "schemaVersion": 1,
  "framework": "selenium",
  "testId": "testClasses.integration.marketing.promotionsAndCoupons.WebstorePromotionAndCouponVerificationTest#T04_verifyPercentOffBrandWithMultipleCoupons",
  "scenario": {
    "summary": "Admin creates two Percent Off Brand coupon promotions for the brand on store Multistore4 and reads back the generated coupon codes. A registered webstore user adds the brand product, sets quantity 5, applies both coupons and checks the combined percent discount, places an Authorize.Net order, and admin verifies the order total and summary.",
    "steps": [
      "Admin login; open Promotions and Coupons list",
      "Create Percent Off Brand coupon (store StoreCode4 label, brand associated, 5 percent, min qty 5) and read the generated coupon code",
      "Create Percent Off Brand coupon 1 and read its generated coupon code",
      "Open webstore and log in as the registered user",
      "Add the brand product (qty 1), open cart, set quantity 5 (MinimumQuantity)",
      "Apply both coupons and verify the order total after both percent discounts",
      "Checkout, select custom flat rate shipping, read order total and summary amounts",
      "Pay with Authorize.Net card; verify order receipt and read order number; log off",
      "Admin: open the order, verify order total and that the order summary matches the webstore"
    ],
    "entitiesTouched": [
      "store",
      "brand",
      "product",
      "user",
      "promotion",
      "cart",
      "order"
    ],
    "stateChanges": [
      "Creates promotion 'runTime Percent Off Brand Coupon' (code runTimePercentOffBrandCoupon, Percent Off Brand, 1 generated coupon) on Multistore4",
      "Creates promotion 'runTime Percent Off Brand Coupon1' (code runTimePercentOffBrandCoupon1, Percent Off Brand, 1 generated coupon) on Multistore4",
      "Registered user's cart: brand product added, quantity set to 5, two coupons applied",
      "Places an order for the brand product (qty 5) with Authorize.Net payment; consumes both generated coupons",
      "No teardown of created promotions or the order is visible in the scanned steps"
    ],
    "assertions": [
      "Record updated success messages after creating each promotion",
      "Order total equals subtotal after both percent coupon discounts",
      "Checkout page title and custom flat rate shipping visible",
      "Order receipt number visible",
      "Admin order total equals the webstore order total",
      "Admin order summary amounts equal the webstore summary amounts"
    ],
    "evidence": [
      "Method name T04_verifyPercentOffBrandWithMultipleCoupons and the scanned step list (createBrandCouponCode x2, verifyOrderTotalForMultipleDiscountPercentCoupons, Authorize.Net checkout, manageOrder.verifyOrderTotal)",
      "Profile: z-2420004 active SimpleProduct of brand BlackAndDecker, inventory 25 (several rows matched, store MaxwellsHardware on first row)",
      "Profile: brand 'Black + Decker' (BlackAndDecker) active; source cell has no traced usage, taken as the brand associated to the promotions",
      "Highest cart quantity of the brand product is 5 (MinimumQuantity of PercentOffBrandCoupon)",
      "Authorize.Net card fields are masked and treated as payment configuration; no vocabulary key covers payment test data",
      "Profile: store MaxwellsHardwareMultistore4 found but isActive=false; runTime promotion codes and names NOT_FOUND, consistent with the test creating them",
      "AIO preconditions not available: the Jira connector is not authorized and work/aio/ is empty"
    ],
    "confidence": "high"
  },
