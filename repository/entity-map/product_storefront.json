{
  "schemaVersion": 1,
  "entity": "product_storefront",
  "tables": [
    "dbo.ZnodePimProduct",
    "dbo.ZnodePublishProductEntity",
    "dbo.ZnodePublishVersionEntity",
    "dbo.ZnodePortalCatalog",
    "dbo.ZnodePortal"
  ],
  "joins": [
    {
      "from": "dbo.ZnodePimProduct.PimProductId",
      "to": "dbo.ZnodePublishProductEntity.ZnodeProductId",
      "kind": "inner"
    },
    {
      "from": "dbo.ZnodePublishProductEntity.VersionId",
      "to": "dbo.ZnodePublishVersionEntity.VersionId",
      "kind": "inner"
    },
    {
      "from": "dbo.ZnodePublishProductEntity.ZnodeCatalogId",
      "to": "dbo.ZnodePortalCatalog.PublishCatalogId",
      "kind": "inner"
    },
    {
      "from": "dbo.ZnodePortalCatalog.PortalId",
      "to": "dbo.ZnodePortal.PortalId",
      "kind": "inner"
    }
  ],
  "properties": {
    "sku": "dbo.ZnodePimProduct.SKU",
    "storefrontActive": "dbo.ZnodePublishProductEntity.IsActive",
    "storefrontObsolete": "dbo.ZnodePublishProductEntity.IsObsolete",
    "storefrontProductIndex": "MIN(dbo.ZnodePublishProductEntity.ProductIndex)"
  },
  "scope": {
    "store": "dbo.ZnodePortal.StoreCode"
  },
  "filters": {
    "dbo.ZnodePublishVersionEntity.RevisionType": "PRODUCTION",
    "dbo.ZnodePublishVersionEntity.IsPublishSuccess": "1"
  },
