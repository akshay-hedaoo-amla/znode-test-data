{
  "schemaVersion": 1,
  "entity": "store_domains",
  "tables": [
    "dbo.ZnodePortal",
    "dbo.ZnodeDomain"
  ],
  "joins": [
    {
      "from": "dbo.ZnodePortal.PortalId",
      "to": "dbo.ZnodeDomain.PortalId",
