{
  "schemaVersion": 1,
  "entity": "brand_products",
  "tables": [
    "dbo.ZnodeBrandDetailLocale",
    "dbo.ZnodeBrandDetails",
    "dbo.ZnodePimProduct",
    "dbo.ZnodePortalBrand",
    "dbo.ZnodePortal"
  ],
  "joins": [
    {
      "from": "dbo.ZnodeBrandDetailLocale.BrandId",
      "to": "dbo.ZnodeBrandDetails.BrandId",
      "kind": "inner"
    },
    {
      "from": "dbo.ZnodeBrandDetails.BrandCode",
      "to": "dbo.ZnodePimProduct.Brand",
      "kind": "left"
    },
    {
      "from": "dbo.ZnodeBrandDetails.BrandId",
      "to": "dbo.ZnodePortalBrand.BrandId",
      "kind": "inner"
    },
    {
      "from": "dbo.ZnodePortalBrand.PortalId",
      "to": "dbo.ZnodePortal.PortalId",
      "kind": "inner"
    }
  ],
  "properties": {
    "name": "dbo.ZnodeBrandDetailLocale.BrandName",
    "productCount": "COUNT(DISTINCT dbo.ZnodePimProduct.PimProductId)"
  },
  "scope": {
    "store": "dbo.ZnodePortal.StoreCode"
  },
  "filters": {
    "dbo.ZnodePimProduct.IsActive": "true"
  },
