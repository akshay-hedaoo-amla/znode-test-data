{
  "schemaVersion": 1,
  "entity": "store_product_compare",
  "tables": [
    "dbo.ZnodePortal",
    "dbo.ZnodeDomain",
    "dbo.ZnodePortalFeatureMapper",
    "dbo.ZnodePortalFeature"
  ],
  "joins": [
    {
      "from": "dbo.ZnodePortal.PortalId",
      "to": "dbo.ZnodeDomain.PortalId",
      "kind": "left"
    },
    {
      "from": "dbo.ZnodePortal.PortalId",
      "to": "dbo.ZnodePortalFeatureMapper.PortalId",
      "kind": "inner"
    },
    {
      "from": "dbo.ZnodePortalFeatureMapper.PortalFeatureId",
      "to": "dbo.ZnodePortalFeature.PortalFeatureId",
      "kind": "inner"
    }
  ],
  "properties": {
    "code": "dbo.ZnodePortal.StoreCode",
    "store": "dbo.ZnodePortal.StoreCode",
    "webstoreDomains": "COUNT(DISTINCT dbo.ZnodeDomain.DomainId)",
    "productCompareSwitches": "COUNT(DISTINCT dbo.ZnodePortalFeatureMapper.PortalFeatureMapperId)"
  },
  "scope": {
    "store": "dbo.ZnodePortal.StoreCode"
  },
  "filters": {
    "dbo.ZnodeDomain.ApplicationType": "WebStore",
    "dbo.ZnodeDomain.IsActive": "1",
    "dbo.ZnodePortalFeature.PortalFeatureName": "Enable_Product_Compare"
  },
  "maskedColumns": [
    "dbo.ZnodeDomain.ApiKey"
  ],
