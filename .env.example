# Template only. Copy to .env (git-ignored) and fill in there, or set as environment variables /
# secrets-manager entries. Never put real values in this file: it is committed.

# Environment identity, checked by the environment guard against config/deny-list.yaml
TDA_ENV_NAME=
TDA_API_BASE_URL=

# Read-only SQL Server user (db_datareader + VIEW DEFINITION; no INSERT/UPDATE/DELETE/DDL/EXECUTE rights)
TDA_DB_HOST=
TDA_DB_PORT=
TDA_DB_NAME=
TDA_DB_USER=
TDA_DB_PASSWORD=
TDA_DB_TRUST_SERVER_CERTIFICATE=false

# Test-environment API client (dbo.ZnodeClient: ClientName / ClientSecret), test environment only
TDA_API_CLIENT_ID=
TDA_API_CLIENT_SECRET=

# Framework repositories the discovery scanners read (local clones, read-only)
TDA_SELENIUM_REPO=
TDA_PLAYWRIGHT_REPO=

# SharePoint workbooks used by the Selenium suite (Microsoft Graph, client-credentials app)
TDA_SHAREPOINT_TENANT_ID=
TDA_SHAREPOINT_CLIENT_ID=
TDA_SHAREPOINT_CLIENT_SECRET=
TDA_SHAREPOINT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
TDA_SHAREPOINT_WEBSTORE_WORKBOOK_URL=
TDA_SHAREPOINT_ADMIN_WORKBOOK_URL=
